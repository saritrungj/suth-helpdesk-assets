# database/docker/compose.env.example — คัดลอกเป็น compose.env (อยู่ใน .gitignore) แล้วตั้งรหัสเอง
#
#   Copy-Item database/docker/compose.env.example database/docker/compose.env
#
# รหัสผ่านห้ามมี ' " \ หรือ $ — สคริปต์สร้างบัญชีปฏิเสธ (compose แปล $ เองใน env file)
# ชื่อบัญชีและชื่อฐานใช้ได้เฉพาะ A-Z a-z 0-9 _
# รหัสทั้งหมดมีผลเฉพาะตอนสร้างฐานครั้งแรก เปลี่ยนทีหลังต้องลบ volume (npm run db:reset)

# image — MySQL 8.4 LTS ตาม ADR-0024 รุ่นเดียวกับชุดทดสอบ npm run verify:db
SUTH_DB_IMAGE=mysql:8.4
SUTH_PMA_IMAGE=phpmyadmin:5.2

SUTH_DB_NAME=hospital_it_asset
SUTH_DB_PORT=3307
SUTH_PMA_PORT=8080

SUTH_DB_ROOT_PASSWORD=
SUTH_APP_USER=suth_app
SUTH_APP_PASSWORD=
SUTH_READONLY_USER=suth_readonly
SUTH_READONLY_PASSWORD=

# รหัสบัญชี admin ของแอป — npm run db:bootstrap ตั้งให้ อย่างน้อย 12 ตัวอักษร
# สคริปต์ลงข้อมูลอ่านค่านี้ผ่าน SUTH_ADMIN_USER / SUTH_ADMIN_PASSWORD
SUTH_ADMIN_PASSWORD=

# ฐานพัฒนาข้อมูลตัวอย่าง (บริการ db-dev, ADR-0032) — ใช้รหัสคนละชุดกับฐานจริงข้างบนเสมอ
# apps/api/.env ของเครื่องพัฒนาชี้ DB_PORT=3308 และใช้ SUTH_DEV_APP_PASSWORD
SUTH_DEV_DB_NAME=hospital_it_asset_dev
SUTH_DEV_DB_PORT=3308
SUTH_DEV_DB_ROOT_PASSWORD=
SUTH_DEV_APP_PASSWORD=
SUTH_DEV_READONLY_PASSWORD=
SUTH_DEV_ADMIN_PASSWORD=
