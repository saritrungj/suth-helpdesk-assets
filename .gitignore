# dependency — workspace เดียว hoist ไว้ที่รากเป็นหลัก แต่ npm ยังวางบางตัวไว้ในแต่ละ package ได้
node_modules/

# ความลับ — ห้าม commit เด็ดขาด ดูตัวอย่างค่าที่ apps/api/.env.example
.env
.env.*
!.env.example

# ผลลัพธ์ที่ build ได้ใหม่เสมอ
dist/
dist-ssr/
*.tsbuildinfo

# ไฟล์ที่ผู้ใช้อัปโหลดเข้ามาตอน import — เป็นข้อมูลจริง ไม่ใช่ซอร์สโค้ด
apps/api/uploads/

# log
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# เครื่องมือและ editor
.DS_Store
Thumbs.db
*.local
.vscode/*
!.vscode/extensions.json
.idea/

# script ชั่วคราวสำหรับสร้าง bcrypt hash — มีรหัสผ่านอยู่ในนั้น
hash.js

# ผลลัพธ์จาก Playwright (apps/web/e2e) — สร้างใหม่ได้ทุกครั้งที่รัน ไม่ใช่ของอ้างอิง
# ที่ต้อง track (ดู docs/how-to/verify-changes.md)
test-results/
playwright-report/
apps/web/e2e/.artifacts/
apps/web/e2e/screens/

# build แยกที่ฝังที่อยู่ API ชั่วคราวไว้สำหรับรันชุด E2E ที่ต้องใช้ฐานข้อมูลจริง
# (scripts/verify-db.cjs ใช้ dist-verify-db ส่วนการรันมือกับฐานชั่วคราวใช้ชื่ออื่น)
# ห้ามเอาไป deploy เด็ดขาด — ที่อยู่ API ข้างในชี้ไปที่เครื่องที่รันเทส
apps/web/dist-verify-*/

# ภาพที่ .claude/skills/run-web/driver.mjs ถ่ายไว้ตอน agent สั่งรันแอป
apps/web/e2e/.driver-shots/

# หลักฐานชั่วคราวจาก browser automation — เก็บไว้ให้ผู้ review ใน working tree แต่สร้างใหม่ได้
output/

# รายงานการตรวจของแต่ละรอบ — เป็นบันทึก ณ จุดเวลาหนึ่ง ไม่ใช่เอกสารระบบ
# ข้อพบที่ต้องตามต่อถูกเปิดเป็น GitHub issue แทน
docs/reference/review-*.md

# การตั้งค่าส่วนตัวของ Claude Code ต่อเครื่อง — ไม่ใช่ของทีม
.claude/settings.local.json

# เครื่องมือ CLI ของ agent ที่ใช้ขับเบราว์เซอร์ระหว่างตรวจงาน ไม่ใช่ส่วนของระบบ
.playwright-cli/

# ใบแจ้งหนี้จริงของผู้ให้เช่า — ข้อมูลจริงของโรงพยาบาล ใช้ทดสอบบนเครื่องเท่านั้น (ADR-0023)
# ไฟล์ Excel/CSV ใน docs/ คือไฟล์จริงของหน่วยงานเสมอ — repo เป็น public เก็บนอก repo (D:suth-dataaw)
docs/**/*.xls
docs/**/*.xlsx
docs/**/*.xlsm
docs/**/*.csv

# ฐานพัฒนาบน Docker — รหัสผ่านของเครื่องนี้ (ADR-0024)
database/docker/compose.env

