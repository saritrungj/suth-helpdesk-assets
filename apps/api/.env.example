# ฐานข้อมูล
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=test

# กุญแจเซ็น JWT — ต้องเป็นค่าสุ่มที่ยาวและไม่ซ้ำใคร ห้ามใช้ค่านี้จริง
JWT_SECRET=your_secret_key_here

# พอร์ตของ API (ไม่บังคับ ค่าเริ่มต้น 3000)
PORT=3000

# origin ของเว็บที่อนุญาตให้เรียก API — คั่นหลายค่าด้วย comma
# ต้องตรงกับที่อยู่จริงของเว็บตอน deploy ไม่งั้นเบราว์เซอร์จะบล็อก
CORS_ORIGIN=http://localhost:5173

# sameSite ของ cookie session — "lax" ใช้ได้เมื่อเว็บกับ API อยู่โดเมนเดียวกัน
# (ต่างพอร์ตหรือต่าง subdomain ยังนับว่าเดียวกัน) ถ้าอยู่คนละโดเมนจริงๆ ต้องใช้ "none"
# ซึ่งบังคับให้ cookie ต้องเป็น secure คือต้องเสิร์ฟผ่าน HTTPS เท่านั้น
COOKIE_SAMESITE=lax

# ตั้งเป็น production บนเครื่องจริง เพื่อบังคับให้ cookie session เป็น secure
NODE_ENV=development

# จำนวนชั้นของ reverse proxy ที่อยู่หน้า API (nginx, IIS, load balancer)
# 0 = รันตรงๆ ไม่มี proxy
#
# ⚠️ ตั้งผิดแล้วตัวจำกัดจำนวนครั้งล็อกอินจะพัง: ตั้งต่ำไป ทุกคำขอจะถูกมองว่ามาจาก
# IP ของ proxy เหมือนกันหมด แล้วคนคนเดียวที่พิมพ์รหัสผิดสิบครั้งจะล็อกทุกคนออกจาก
# ระบบ · ตั้งสูงไป ผู้โจมตีปลอม header X-Forwarded-For เพื่อหลบการจำกัดได้
TRUST_PROXY_HOPS=0

# จำนวนคำขอสูงสุดต่อนาทีต่อ IP (ไม่บังคับ ค่าเริ่มต้น 600)
# หน้าหนึ่งยิงประมาณสิบคำขอ ค่านี้จึงหลวมพอที่ผู้ใช้จริงไม่มีทางชน
RATE_LIMIT_PER_MINUTE=600

# รูปแบบล็อก: "pretty" อ่านง่ายบนหน้าจอ · "json" หนึ่งบรรทัดต่อเหตุการณ์สำหรับ
# เครื่องมืออ่านต่อ (ไม่ตั้ง = pretty ตอนพัฒนา, json ตอน production)
# LOG_FORMAT=json

# ระดับล็อกต่ำสุดที่บันทึก: debug | info | warn | error (ค่าเริ่มต้น info)
# LOG_LEVEL=info

# ขนาด connection pool ของฐานข้อมูล (ไม่บังคับ ค่าเริ่มต้น 10)
# DB_POOL_SIZE=10

# พอร์ตของฐานข้อมูล (ไม่บังคับ ค่าเริ่มต้น 3306)
# DB_PORT=3306
