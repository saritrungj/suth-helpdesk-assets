root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown ใช้ช่องว่างท้ายบรรทัดสองตัวเป็นการขึ้นบรรทัดใหม่ ห้ามตัดทิ้ง
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
