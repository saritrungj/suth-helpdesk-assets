{
  "name": "suth-helpdesk-assets",
  "version": "0.0.0",
  "private": true,
  "description": "ระบบจัดการทรัพย์สิน IT โรงพยาบาล — API, เว็บ และกฎธุรกิจที่ใช้ร่วมกัน",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @suth/api",
    "dev:web": "npm run dev --workspace @suth/web",
    "start": "npm run start --workspace @suth/api",
    "build": "npm run build --workspace @suth/web",
    "preview": "npm run preview --workspace @suth/web",
    "test": "npm run test --workspaces --if-present && node --test scripts/playwright-report.test.cjs scripts/check-bundle-budget.test.cjs scripts/web-vitals-report.test.cjs",
    "verify": "npm test && npm run build && node scripts/check-bundle-budget.cjs && node scripts/verify-fixture.cjs",
    "verify:db": "node scripts/verify-db.cjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "db:up": "docker compose --env-file database/docker/compose.env up -d --wait",
    "db:down": "docker compose --env-file database/docker/compose.env down",
    "db:reset": "node scripts/dev-db/backup.cjs reset",
    "db:logs": "docker compose --env-file database/docker/compose.env logs -f db",
    "db:bootstrap": "node scripts/dev-db/bootstrap-admin.cjs",
    "db:dump": "node scripts/dev-db/backup.cjs dump",
    "db:restore": "node scripts/dev-db/backup.cjs restore"
  },
  "engines": {
    "node": ">=20"
  }
}
