# Copy to .env.assets, set real secrets and align the public origin with the TLS certificate.
# Example only: verify the actual network name with docker inspect mysql84.
SUTH_MYSQL_NETWORK=docker-compose_modern_net
SUTH_PROXY_NETWORK=php-docker_default
SUTH_DB_HOST=mysql84
SUTH_DB_NAME=hospital_it_asset
SUTH_DB_USER=suth_app
SUTH_DB_PASSWORD=
SUTH_JWT_SECRET=
SUTH_NODE_ENV=production
SUTH_TRUST_PROXY_HOPS=1

# Local-only HTTP listener. It binds to loopback and does not take over ports 80 or 443.
SUTH_HTTP_PORT=8081
SUTH_PUBLIC_ORIGIN=https://helpdesk.example.org
